{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "privacy",
  "pages_build_output_dir": "./dist",
  // Same runtime date as the previous Worker so letter behavior stays the same.
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "dev": {
    "port": 8787
  },
  "vars": {
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "AI_DAILY_LIMIT_PER_VISITOR": "10",
    // Sample letters for local preview. Real deploys must stay "false".
    "MOCK_GROQ": "false"
  },
  // Daily AI cap. The Workers Rate Limiting binding only allows a 10 or 60
  // second window, so it cannot count "10 letters per day". This KV namespace
  // stores a hashed visitor id, the UTC date, and a number. Nothing else.
  // The namespace already exists. Do not create a second one.
  "kv_namespaces": [
    {
      "binding": "AI_USAGE",
      "id": "6af39e158b4d4adda9dde57614983066"
    }
  ]
}
