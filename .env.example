# Copy this file to .dev.vars for local `npx wrangler pages dev`.
# Do not commit .dev.vars. It stays on your computer.
#
# Groq secret. Leave blank until you have a key.
# Production uses `npx wrangler pages secret put GROQ_API_KEY --project-name privacy`
# instead of this file. That command sets the production secret.
GROQ_API_KEY=

# Which Groq model writes the letter. This default matches wrangler.jsonc.
GROQ_MODEL=openai/gpt-oss-120b

# Letters allowed per visitor per UTC day. The app also has this default in code.
AI_DAILY_LIMIT_PER_VISITOR=10

# Local preview only. "true" returns a sample letter and does not call Groq.
# Leave false when you deploy.
MOCK_GROQ=false
